<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (PRD 6.1): two tap targets, capture and view today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cya!"/>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="I'll remember for you."/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_capture"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_capture_button"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:contentDescription="Save something to Cya!"
        android:text="+"/>
</LinearLayout>
