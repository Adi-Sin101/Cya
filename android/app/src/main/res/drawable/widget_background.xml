<?xml version="1.0" encoding="utf-8"?>
<!-- The widget sits on the user's wallpaper, so it carries the brand gradient
     rather than a system surface (PRD 8.1). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp"/>
    <gradient
        android:angle="315"
        android:startColor="#2E705B"
        android:endColor="#74B69D"/>
</shape>
